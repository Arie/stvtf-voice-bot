# Sourced by kamal. Nothing secret is in this file: each is read from ~/.config/stvtf.
# A classic token with only the write:packages scope (the one stv.tf deploys with).
KAMAL_REGISTRY_PASSWORD=$(cat ~/.config/stvtf/ghcr.token)
# The bot's own token, from its Discord application (Bot, Reset Token).
DISCORD_TOKEN=$(cat ~/.config/stvtf/voice-bot.token)
# Shared with every stv.tf region, which take voice only with it. Generate once with
# `openssl rand -hex 32 > ~/.config/stvtf/voice.key`.
STVTF_VOICE_KEY=$(cat ~/.config/stvtf/voice.key)
