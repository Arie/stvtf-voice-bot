{
  "name": "stvtf-voice-bot",
  "private": true,
  "type": "module",
  "description": "A Discord bot that sits in a voice channel and passes its speakers' voice to a match on stv.tf",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/bot.mjs",
    "lint": "eslint src test script",
    "format": "prettier --write \"src/**/*.mjs\" \"test/**/*.mjs\" \"script/**/*.mjs\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.mjs\" \"test/**/*.mjs\" \"script/**/*.mjs\" eslint.config.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.28.1",
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
